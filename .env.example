# https://wavespeed.ai/accesskey
WAVESPEED_API_KEY=
# Optional fallback (if your runtime doesn't pick server-only env):
# NEXT_PUBLIC_WAVESPEED_API_KEY=

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias (server only) if you omitted NEXT_PUBLIC_ on the anon key:
# SUPABASE_ANON_KEY=

# Optional — if dev shows a blank page / 403 on assets when using a LAN URL:
# NEXT_DEV_ALLOWED_ORIGINS=192.168.1.10
